<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Тест тайлов</title>
  <style>
    body { background: #1a1a1a; font-family: Arial; color: #fff; padding: 20px; }
    .tile-grid { display: grid; grid-template-columns: repeat(6, 256px); gap: 10px; margin-top: 20px; }
    .tile-item { border: 1px solid #444; background: #2a2a2a; text-align: center; }
    .tile-item img { width: 256px; height: 256px; display: block; }
    .tile-item span { display: block; padding: 5px; font-size: 12px; color: #888; }
    .status { padding: 10px; margin: 10px 0; border-radius: 5px; }
    .ok { background: #1a3a1a; color: #8f8; }
    .error { background: #3a1a1a; color: #f88; }
  </style>
</head>
<body>
  <h1>🧪 Тест тайлов tiles2</h1>
  <div id="result">⏳ Проверяю...</div>
  <div class="tile-grid" id="grid"></div>

  <script>
    // Проверяем первые 6 тайлов
    const testFiles = [
      'tile_01.jpg',
      'tile_02.jpg',
      'tile_03.jpg',
      'tile_04.jpg',
      'tile_05.jpg',
      'tile_06.jpg',
    ];

    const grid = document.getElementById('grid');
    const result = document.getElementById('result');
    let loaded = 0;
    let failed = 0;

    // Определяем правильный путь (с учётом GitHub Pages)
    const basePath = window.location.pathname.replace(/\/[^/]*$/, '/');
    const tilePath = basePath + 'tiles2/';

    console.log('🔍 Ищем тайлы по адресу:', tilePath);

    testFiles.forEach((file, index) => {
      const div = document.createElement('div');
      div.className = 'tile-item';

      const img = document.createElement('img');
      const url = tilePath + file;
      img.src = url;
      img.alt = file;

      const span = document.createElement('span');
      span.textContent = file;

      img.onload = () => {
        loaded++;
        span.style.color = '#8f8';
        span.textContent = file + ' ✅';
        updateStatus();
      };

      img.onerror = () => {
        failed++;
        span.style.color = '#f88';
        span.textContent = file + ' ❌ (404)';
        div.style.borderColor = '#800';
        updateStatus();
        console.error('❌ Не загрузился:', url);
      };

      div.appendChild(img);
      div.appendChild(span);
      grid.appendChild(div);
    });

    function updateStatus() {
      const total = testFiles.length;
      if (loaded + failed === total) {
        if (failed === 0) {
          result.innerHTML = `✅ <b>Все 6 тайлов загрузились!</b> Тайлы лежат в папке <code>${tilePath}</code>`;
          result.className = 'status ok';
        } else {
          result.innerHTML = `❌ <b>Загрузилось ${loaded} из ${total}</b>. Проверь папку <code>tiles2</code> в корне репозитория.`;
          result.className = 'status error';
        }
      } else {
        result.innerHTML = `⏳ Загружено ${loaded + failed} из ${total}...`;
      }
    }
  </script>
</body>
</html>
